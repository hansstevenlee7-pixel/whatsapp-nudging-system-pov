# Local n8n environment — copy this file to `local/n8n.env` and fill in.
# `local/n8n.env` is gitignored and must NEVER be committed.
# Docker --env-file format: KEY=VALUE per line, no quotes, no `export`.

# --- n8n core ---
GENERIC_TIMEZONE=Australia/Melbourne
TZ=Australia/Melbourne
# Persist credentials across restarts. Generate once: openssl rand -hex 16
N8N_ENCRYPTION_KEY=
# Shared with Vercel. Generate once with: openssl rand -hex 32
N8N_PROXY_SECRET=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
VERIFY_TOKEN=

# --- Twilio WhatsApp Sandbox ---
# Required for either authentication method.
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option A: Account SID + Auth Token (simplest for local testing).
TWILIO_AUTH_TOKEN=

# Option B: API Key SID + API Key Secret (use these for a Twilio API key).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Content Template SIDs. These are identifiers, not secrets, but are left blank
# here so this file stays a template. Real values are recorded in
# docs/TWO_STAGE_FEEDBACK.md.
# Single-stage quick reply: Done / In progress / Not yet.
TWILIO_CONTENT_SID=
# Two-stage flow. Stage 1 (Workflow B): Yes / No. Stage 2 (Workflow F): Done / Not yet.
TWILIO_COMMITMENT_CONTENT_SID=
TWILIO_OUTCOME_CONTENT_SID=
# Hours a stage-2 window stays open before the silence becomes NO_FEEDBACK.
FOLLOWUP_OUTCOME_WINDOW_HOURS=24

# --- Gemini ---
GEMINI_API_KEY=

# --- Google Sheets ---
GOOGLE_SHEETS_SPREADSHEET_ID=
