{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adaptive Media Lifestyle Nudging System Schema",
  "description": "Flat Google Sheets contract for clinician review, taxonomy-driven media assignment, scheduled WhatsApp delivery, interaction capture, STOP safety, and auditable system events.",
  "type": "object",
  "required": [
    "user",
    "questionnaire",
    "prescriptions",
    "nudges",
    "weekly_schedule",
    "schedule_state",
    "delivery_events",
    "media_assignments",
    "interaction_events",
    "adaptation_decisions",
    "patient_adaptation_state",
    "patient_adaptation_timeline"
  ],
  "additionalProperties": false,
  "$defs": {
    "pillar": {
      "type": "string",
      "enum": [
        "nutrition",
        "physical_activity",
        "sleep",
        "stress_management",
        "substance_use",
        "social_connection"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "increase",
        "reduce",
        "maintain",
        "avoid",
        "establish"
      ]
    },
    "nudge_type": {
      "type": "string",
      "enum": [
        "reminder",
        "reflection",
        "challenge",
        "affirmation"
      ]
    },
    "nudge_status": {
      "type": "string",
      "enum": [
        "pending",
        "needs_review",
        "approved",
        "rejected",
        "accepted",
        "queued",
        "sending",
        "sent",
        "delivered",
        "read",
        "failed",
        "undelivered",
        "canceled"
      ],
      "description": "Review and outbound delivery lifecycle. Provider states are system observations, not patient adherence outcomes."
    },
    "tone_variant": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "encouraging",
        "neutral_informational",
        null
      ]
    },
    "action_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Clinician-editable execution step: the concrete thing the patient is asked to do for this nudge slot. Drafted by the LLM at intake, freely revised by the clinician at review, and immutable to weekly adaptation. Free text by design — pillar and category remain the locked taxonomy, so the research trace stays raw prescription → locked pillar/category → clinician-approved action → message → feedback."
    }
  },
  "x_legacy_action_labels": {
    "description": "Schema annotation (not a JSON-Schema keyword; ignored by validators). Migration aid only: readable text for rows written before action_text existed, keyed by the retired prescriptions.target_behavior token. Nothing generates these tokens any more — the LLM drafts action_text and the clinician revises it. Default nudge timing now comes from the patient's preferred_nudge_time or the source nudge, not from this table.",
    "daily_steps_10000": "Walk 10,000 steps",
    "daily_steps_7500": "Walk 7,500 steps",
    "daily_steps_5000": "Walk 5,000 steps",
    "aerobic_exercise_30min": "Do 30 minutes of aerobic exercise",
    "aerobic_exercise_20min": "Do 20 minutes of aerobic exercise",
    "resistance_training_2x_week": "Do resistance training twice this week",
    "resistance_training_3x_week": "Do resistance training three times this week",
    "vegetable_servings_5_per_day": "Eat 5 servings of vegetables",
    "fruit_servings_2_per_day": "Eat 2 servings of fruit",
    "sugar_intake_reduction": "Reduce sugar intake",
    "processed_food_reduction": "Reduce processed food",
    "water_intake_2L_per_day": "Drink 2 litres of water",
    "alcohol_reduction": "Reduce alcohol",
    "alcohol_elimination": "Avoid alcohol entirely",
    "smoking_reduction": "Reduce smoking",
    "smoking_cessation": "Stay smoke-free",
    "sleep_7_to_9_hours": "Sleep 7–9 hours",
    "sleep_onset_consistency": "Go to bed at a consistent time",
    "screen_time_reduction_before_bed": "Cut screen time before bed",
    "mindfulness_10min_daily": "Do 10 minutes of mindfulness",
    "mindfulness_5min_daily": "Do 5 minutes of mindfulness",
    "social_activity_1x_week": "Take part in a social activity once this week",
    "social_activity_2x_week": "Take part in a social activity twice this week",
    "stress_journaling_daily": "Write a short stress journal entry",
    "deep_breathing_daily": "Do a deep-breathing exercise"
  },
  "properties": {
    "user": {
      "type": "array",
      "description": "One record per registered user.",
      "items": {
        "type": "object",
        "required": [
          "user_id",
          "doctor_id",
          "name",
          "phone",
          "email",
          "created_at",
          "user_status"
        ],
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "description": "UUID v4"
          },
          "doctor_id": {
            "type": "string",
            "description": "Immutable clinician identity that owns this patient"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{7,14}$",
            "description": "E.164 format, e.g. +61412345678"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "user_status": {
            "type": "string",
            "enum": [
              "active",
              "disabled",
              "opted_out",
              "paused"
            ],
            "description": "disabled is a reversible clinical archive; opted_out is set by STOP. Workflow B sends only to active users."
          }
        }
      }
    },
    "questionnaire": {
      "type": "array",
      "description": "Baseline lifestyle/health questionnaire completed at enrolment. One record per user.",
      "items": {
        "type": "object",
        "required": [
          "questionnaire_id",
          "user_id",
          "completed_at",
          "age",
          "gender",
          "activity_level",
          "primary_goal",
          "preferred_nudge_time",
          "opt_in_whatsapp"
        ],
        "additionalProperties": false,
        "properties": {
          "questionnaire_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "age": {
            "type": "integer",
            "minimum": 18,
            "maximum": 120
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "non_binary",
              "prefer_not_to_say"
            ]
          },
          "activity_level": {
            "type": "string",
            "enum": [
              "sedentary",
              "lightly_active",
              "moderately_active",
              "very_active"
            ]
          },
          "primary_goal": {
            "type": "string",
            "enum": [
              "weight_management",
              "cardiovascular_health",
              "mental_wellbeing",
              "sleep_improvement",
              "substance_reduction",
              "social_engagement",
              "general_wellness"
            ]
          },
          "preferred_nudge_time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "HH:MM in user's local time"
          },
          "opt_in_whatsapp": {
            "type": "boolean"
          }
        }
      }
    },
    "prescriptions": {
      "type": "array",
      "description": "Canonical prescription objects parsed from the doctor's free-text input by the LLM at intake. A prescription is the doctor's note, not a single behaviour: the taxonomy triple (action_text × pillar × category) lives on each nudge and weekly slot, so one prescription may span several pillars. The pillar and category here are the DEFAULTS a new behaviour starts from and the fallback for legacy rows that carry none — they are not a lock.",
      "items": {
        "type": "object",
        "required": [
          "prescription_id",
          "user_id",
          "doctor_id",
          "issued_date",
          "pillar",
          "category",
          "frequency_per_week",
          "duration_weeks",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "prescription_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "doctor_id": {
            "type": "string"
          },
          "issued_date": {
            "type": "string",
            "format": "date"
          },
          "pillar": {
            "$ref": "#/$defs/pillar",
            "description": "Default pillar for behaviours added to this prescription, and the fallback for a legacy nudge or slot whose own pillar is blank. Changing it never rewrites an existing behaviour."
          },
          "category": {
            "$ref": "#/$defs/category",
            "description": "Default category for behaviours added to this prescription, and the fallback for a nudge or slot whose own category is blank."
          },
          "target_behavior": {
            "type": [
              "string",
              "null"
            ],
            "description": "RETIRED fixed-action enum. Nothing writes this any more; it is retained only so legacy rows still validate and can be migrated to action_text through x_legacy_action_labels. Blank on every new row.",
            "enum": [
              "",
              null,
              "daily_steps_10000",
              "daily_steps_7500",
              "daily_steps_5000",
              "aerobic_exercise_30min",
              "aerobic_exercise_20min",
              "resistance_training_2x_week",
              "resistance_training_3x_week",
              "vegetable_servings_5_per_day",
              "fruit_servings_2_per_day",
              "sugar_intake_reduction",
              "processed_food_reduction",
              "water_intake_2L_per_day",
              "alcohol_reduction",
              "alcohol_elimination",
              "smoking_reduction",
              "smoking_cessation",
              "sleep_7_to_9_hours",
              "sleep_onset_consistency",
              "screen_time_reduction_before_bed",
              "mindfulness_10min_daily",
              "mindfulness_5min_daily",
              "social_activity_1x_week",
              "social_activity_2x_week",
              "stress_journaling_daily",
              "deep_breathing_daily"
            ]
          },
          "frequency_per_week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "duration_weeks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 52
          },
          "prescription_raw_text": {
            "type": "string",
            "description": "Original free-text from the doctor. Stored for audit; not used downstream."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "paused",
              "withdrawn",
              "archived"
            ],
            "description": "archived is a reversible clinical archive set by the clinician portal: the prescription's weekly slots are deactivated and its unsent future nudges cancelled, while sent history is preserved. Reactivating restores the prescription only — the schedule must be rebuilt and re-approved. A blank value reads as active."
          }
        }
      }
    },
    "nudges": {
      "type": "array",
      "description": "Pre-written nudge messages generated in bulk at intake (single LLM call). message_body and message_body_alt are the only LLM free-text fields — all others are enumerations.",
      "items": {
        "type": "object",
        "required": [
          "nudge_id",
          "prescription_id",
          "user_id",
          "nudge_type",
          "pillar",
          "action_text",
          "scheduled_date",
          "scheduled_time",
          "message_body",
          "template_name",
          "status",
          "week_number",
          "tone_variant"
        ],
        "additionalProperties": false,
        "properties": {
          "nudge_id": {
            "type": "string"
          },
          "schedule_slot_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stable recurring slot that materialized this delivery. Null on intake/source nudges."
          },
          "prescription_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "nudge_type": {
            "$ref": "#/$defs/nudge_type"
          },
          "pillar": {
            "$ref": "#/$defs/pillar",
            "description": "This behaviour's own pillar. Copied verbatim from the weekly slot on a dated delivery. Need not match the prescription's default — one prescription may span pillars."
          },
          "category": {
            "$ref": "#/$defs/category",
            "description": "This behaviour's own category, alongside pillar and action_text. Blank on a legacy row, which falls back to the prescription's default on read and is filled on the clinician's next save."
          },
          "action_text": {
            "$ref": "#/$defs/action_text",
            "description": "What the patient is asked to do. On a dated delivery row this is copied verbatim from its weekly slot; on a source nudge it is the LLM's intake draft."
          },
          "scheduled_date": {
            "type": "string",
            "format": "date"
          },
          "scheduled_time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "message_body": {
            "type": "string",
            "description": "LLM-generated nudge text (primary tone). Injected into WhatsApp template {{1}}.",
            "minLength": 1,
            "maxLength": 1024
          },
          "message_body_alt": {
            "type": [
              "string",
              "null"
            ],
            "description": "LLM-generated alternate wording retained for clinician choice during review.",
            "maxLength": 1024
          },
          "tone_variant": {
            "$ref": "#/$defs/tone_variant",
            "description": "Tone of message_body. message_body_alt is the opposite tone. Workflow B uses schedule_state.tone_sent to decide which body to send."
          },
          "template_name": {
            "type": "string",
            "enum": [
              "health_plan_reminder",
              "hello_world"
            ],
            "description": "Approved WhatsApp template name. Use hello_world for dev/test only."
          },
          "status": {
            "$ref": "#/$defs/nudge_status"
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Set by the clinician portal when a nudge is approved or rejected."
          },
          "week_number": {
            "type": "integer",
            "minimum": 1
          },
          "media_selection_mode": {
            "type": ["string", "null"],
            "enum": ["automatic", "text_only", "clinician_selected", null]
          },
          "media_override_asset_id": {
            "type": ["string", "null"]
          },
          "media_asset_id": {
            "type": ["string", "null"]
          },
          "adaptation_decision_id": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "weekly_schedule": {
      "type": "array",
      "description": "Canonical recurring schedule. One durable row per patient slot; inactive rows are retained as deletion tombstones so delivery history can never recreate a removed weekday.",
      "items": {
        "type": "object",
        "required": [
          "schedule_slot_id",
          "user_id",
          "source_nudge_id",
          "prescription_id",
          "day",
          "scheduled_time",
          "nudge_type",
          "pillar",
          "action_text",
          "tone_variant",
          "message_body",
          "template_name",
          "status",
          "start_date",
          "end_date",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "schedule_slot_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "source_nudge_id": {
            "type": "string"
          },
          "prescription_id": {
            "type": "string"
          },
          "day": {
            "type": "string",
            "enum": [
              "sunday",
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday"
            ]
          },
          "scheduled_time": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "nudge_type": {
            "$ref": "#/$defs/nudge_type"
          },
          "pillar": {
            "$ref": "#/$defs/pillar",
            "description": "Authoritative pillar for this recurring slot, part of the behaviour triple with category and action_text. Two slots under one prescription may sit in different pillars."
          },
          "category": {
            "$ref": "#/$defs/category",
            "description": "Authoritative category for this recurring slot. Blank on a slot saved before the behaviour taxonomy existed; the read path falls back to the prescription's default and the next clinician save writes it."
          },
          "action_text": {
            "$ref": "#/$defs/action_text",
            "description": "Authoritative action for this recurring slot. Two slots under the same prescription may carry different actions. Copied to every dated nudge materialized from the slot."
          },
          "tone_variant": {
            "$ref": "#/$defs/tone_variant"
          },
          "message_body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "message_body_alt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "template_name": {
            "type": "string",
            "enum": [
              "health_plan_reminder",
              "hello_world"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "media_selection_mode": {
            "type": ["string", "null"],
            "enum": ["automatic", "text_only", "clinician_selected", null]
          },
          "media_override_asset_id": {
            "type": ["string", "null"]
          },
          "media_asset_id": {
            "type": ["string", "null"]
          },
          "adaptation_decision_id": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "schedule_state": {
      "type": "array",
      "description": "Current outbound delivery state for each approved nudge. Twilio acceptance and signed status callbacks update this row.",
      "items": {
        "type": "object",
        "required": [
          "schedule_id",
          "nudge_id",
          "user_id",
          "status",
          "last_updated"
        ],
        "additionalProperties": false,
        "properties": {
          "schedule_id": {
            "type": "string"
          },
          "nudge_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "parent_nudge_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The clinician-approved delivery nudge represented by this state row; normally equal to nudge_id."
          },
          "status": {
            "$ref": "#/$defs/nudge_status"
          },
          "sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "delivered_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Twilio-reported delivery timestamp for the initial message. The follow-up due time anchors to this when present and falls back to sent_at otherwise. Populated only once delivery-status callbacks are implemented (build order step 3); blank until then, so today the anchor is always sent_at."
          },
          "wa_message_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Outbound Twilio Message SID stored by Workflow B and matched by signed delivery-status callbacks."
          },
          "tone_sent": {
            "$ref": "#/$defs/tone_variant",
            "description": "Tone variant submitted for delivery. Null until sent."
          },
          "last_updated": {
            "type": "string",
            "format": "date-time"
          },
          "read_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "interacted_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "last_inbound_message_sid": {
            "type": ["string", "null"]
          },
          "delivery_attempt_id": {
            "type": ["string", "null"],
            "description": "Unique reservation created before the Twilio submission. A non-empty value prevents an uncertain request from being sent again automatically."
          },
          "submission_started_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      }
    },
    "delivery_events": {
      "type": "array",
      "description": "Append-only provider callback log. It records what the messaging system observed and does not represent patient adherence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_at",
          "wa_message_id",
          "nudge_id",
          "user_id",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "event_at": {
            "type": "string",
            "format": "date-time"
          },
          "wa_message_id": {
            "type": "string"
          },
          "nudge_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "queued",
              "sending",
              "sent",
              "delivered",
              "read",
              "failed",
              "undelivered",
              "canceled",
              "unknown"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "channel_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_payload": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "media_assignments": {
      "type": "array",
      "description": "Append-only export of the approved resource and adaptation decision attached to each outbound nudge.",
      "items": { "type": "object" }
    },
    "interaction_events": {
      "type": "array",
      "description": "Append-only exact inbound reply audit. Interaction is not adherence.",
      "items": { "type": "object" }
    },
    "adaptation_decisions": {
      "type": "array",
      "description": "Append-only explainability export: signal, rule, bounded outcome, reason, and before/after state.",
      "items": { "type": "object" }
    },
    "patient_adaptation_state": {
      "type": "array",
      "description": "Current patient adaptation state for the global fallback and each behaviour-specific scope.",
      "items": {
        "type": "object",
        "required": ["user_id", "scope", "behaviour_key", "state_version", "updated_at"],
        "additionalProperties": false,
        "properties": {
          "user_id": { "type": "string" },
          "scope": { "type": "string", "enum": ["global", "behaviour"] },
          "behaviour_key": { "type": "string" },
          "state_version": { "type": ["integer", "string"] },
          "preferred_format": { "type": "string" },
          "preferred_frequency": { "type": ["integer", "string", "null"] },
          "planned_frequency": { "type": ["integer", "string", "null"] },
          "delivered_frequency": { "type": ["integer", "string", "null"] },
          "observed_frequency": { "type": ["integer", "string", "null"] },
          "last_change_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    },
    "patient_adaptation_timeline": {
      "type": "array",
      "description": "Append-only patient adaptation timeline for research export and clinician drill-down.",
      "items": {
        "type": "object",
        "required": ["user_id", "event_id", "event_at", "event_type"],
        "additionalProperties": false,
        "properties": {
          "user_id": { "type": "string" },
          "event_id": { "type": "string" },
          "event_at": { "type": "string" },
          "event_type": { "type": "string" },
          "source": { "type": "string" },
          "scope": { "type": "string", "enum": ["global", "behaviour"] },
          "behaviour_key": { "type": "string" },
          "signal": { "type": "string" },
          "rule_applied": { "type": "string" },
          "outcome": { "type": "string" },
          "reason": { "type": "string" },
          "previous_state": { "type": "string" },
